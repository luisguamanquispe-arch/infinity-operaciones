# =============================================================================
# Infinity Operaciones — Variables de entorno
# Copia este archivo a .env y completa los valores
# =============================================================================

# --- Base de datos ---
# Desarrollo local (Neon gratis o Docker — ver PUBLICAR-LGB.md):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# SQLite ya no se usa en este proyecto.

# --- Seguridad JWT (obligatorio, mínimo 32 caracteres) ---
# Generar: openssl rand -base64 48
JWT_SECRET="CAMBIAR-genera-un-secreto-largo-y-aleatorio-minimo-32-chars"

# --- WhatsApp Business — Meta Cloud API ---
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE="0995870168"
# Token permanente desde Meta Business Suite > WhatsApp > API Setup
WHATSAPP_API_TOKEN=""
# ID del número de teléfono WhatsApp Business (no el número en sí)
WHATSAPP_PHONE_NUMBER_ID=""
# Plantilla aprobada en Meta (recomendado). Ejemplo cuerpo:
# "Infinity Internet informa que su ticket {{1}} ha sido solucionado. Contacto: {{2}}"
WHATSAPP_TEMPLATE_NAME="ticket_cerrado"
# Plantilla para alertas a técnicos (ticket nuevo). Cuerpo sugerido en Meta:
# "Hola {{1}}, ticket {{2}}. Cliente: {{3}} — {{4}}. Programado: {{5}}. Motivo: {{6}}"
WHATSAPP_TEMPLATE_TECNICO="ticket_asignado_tecnico"
WHATSAPP_API_VERSION="v21.0"

# URL de la app para técnicos (link en WhatsApp)
PUBLIC_APP_URL="https://infinity-operaciones-b3ij.onrender.com/login?app=tecnico"

# --- Almacenamiento de fotos ---
# local = disco del servidor (VPS/Railway con volumen)
# s3    = AWS S3 / Cloudflare R2 (requerido en Vercel)
UPLOAD_STORAGE="local"

# Solo si UPLOAD_STORAGE=s3
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- INFINITY Connect (app clientes) / Wispro (solo servidor) ---
# WISPRO_API_URL="https://api.wispro.co/..."
# WISPRO_API_TOKEN=""
# SETUP_TOKEN se usa para /api/setup/cliente-app-usuario (crear usuario demo CLIENTE)

# --- IA (Help Desk copiloto + bot chat Connect) ---
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Push FCM (INFINITY Connect) ---
# Server key legacy de Firebase Cloud Messaging. Sin valor = modo stub (solo logs).
# FCM_SERVER_KEY=""

# --- Backup programado (opcional) ---
# Bearer para POST /api/backup/cron
# BACKUP_CRON_SECRET=""

# --- Entorno ---
NODE_ENV="development"
