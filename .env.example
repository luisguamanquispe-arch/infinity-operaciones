# =============================================================================
# Infinity Operaciones — Variables de entorno
# Copia este archivo a .env y completa los valores
# =============================================================================

# --- Base de datos ---
# Desarrollo local (Neon gratis o Docker — ver PUBLICAR-LGB.md):
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# SQLite ya no se usa en este proyecto.

# --- Seguridad JWT (obligatorio, mínimo 32 caracteres) ---
# Generar: openssl rand -base64 48
JWT_SECRET="CAMBIAR-genera-un-secreto-largo-y-aleatorio-minimo-32-chars"

# --- WhatsApp Business — Meta Cloud API ---
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE="0995870168"
# Token permanente desde Meta Business Suite > WhatsApp > API Setup
WHATSAPP_API_TOKEN=""
# ID del número de teléfono WhatsApp Business (no el número en sí)
WHATSAPP_PHONE_NUMBER_ID=""
# Plantilla aprobada en Meta (recomendado). Ejemplo cuerpo:
# "Infinity Internet informa que su ticket {{1}} ha sido solucionado. Contacto: {{2}}"
WHATSAPP_TEMPLATE_NAME="ticket_cerrado"
WHATSAPP_API_VERSION="v21.0"

# --- Almacenamiento de fotos ---
# local = disco del servidor (VPS/Railway con volumen)
# s3    = AWS S3 / Cloudflare R2 (requerido en Vercel)
UPLOAD_STORAGE="local"

# Solo si UPLOAD_STORAGE=s3
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- Entorno ---
NODE_ENV="development"
