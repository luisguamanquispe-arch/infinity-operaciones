generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  TECNICO
  SUPERVISOR
  ADMIN
  HELP_DESK
}

enum EstadoTecnico {
  DISPONIBLE
  TRABAJANDO
  DESCANSO
  OFFLINE
}

enum TipoTrabajo {
  INSTALACION
  SOPORTE
  INFRAESTRUCTURA
  MIGRACION
  RECONEXION
  RETIRO
  CORTE
}

enum MotivoInfraestructura {
  CORTE_ELECTRICO
  CORTE_FIBRA
  CONFIG_NODO
  ACTUALIZACION
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoTicket {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  CERRADO
  CANCELADO
}

enum TipoConexionInstalacion {
  IP
  PPPOE
}

enum TipoFoto {
  FACHADA
  POSTE
  NAP
  TRABAJO
  EMPALME
  CAJA_TERMINAL
  ONU
  SPEEDTEST
  CLIENTE_CONFORME
}

enum TipoInventario {
  CONSUMIBLE
  PATCHCORD
  EQUIPO
}

enum TipoPatchCord {
  APC_APC
  APC_UPC
  UPC_UPC
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  tecnico      Tecnico?
  eventos      EventoTicket[]
  conversacionesHelpDesk HdConversacion[] @relation("HdAgenteUsuario")
  accionesHelpDesk       HdAccionRemota[]
  sesionHelpDesk         HdSesionAgente?
}

model Tecnico {
  id           String        @id @default(cuid())
  usuarioId    String        @unique
  telefono     String?
  vehiculo     String?
  estadoActual EstadoTecnico @default(DISPONIBLE)
  lat          Float?
  lng          Float?
  updatedAt    DateTime      @updatedAt
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  asignaciones TicketTecnico[]
  ubicaciones  UbicacionGps[]
  ordenesReportadas OrdenServicio[] @relation("OrdenReportadaPor")
}

model Cliente {
  id        String   @id @default(cuid())
  cedula    String   @unique
  nombre    String
  telefono  String
  plan      String
  direccion String
  sector    String
  referencia String?
  lat       Float?
  lng       Float?
  nodo      String?
  cajaNap   String?
  puerto    String?
  onuSerial String?
  potencia  Float?
  activo    Boolean  @default(true)
  tickets   Ticket[]
  conversacionesHelpDesk HdConversacion[]
}

model Ticket {
  id                   String                 @id @default(cuid())
  codigo               String                 @unique
  clienteId            String
  tecnicoId            String?
  tipo                 TipoTrabajo
  prioridad            Prioridad              @default(MEDIA)
  estado               EstadoTicket           @default(PENDIENTE)
  motivo               String?
  descripcion          String?
  motivoInfraestructura MotivoInfraestructura?
  nodoAfectado         String?
  zonaInfra            String?
  slaHoras             Int                    @default(8)
  slaVenceEn           DateTime?
  programadoEn         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  cliente              Cliente                @relation(fields: [clienteId], references: [id])
  tecnico              Tecnico?               @relation(fields: [tecnicoId], references: [id])
  tecnicos             TicketTecnico[]
  orden                OrdenServicio?
  eventos              EventoTicket[]
  conversacionHelpDesk HdConversacion?
  escalamientoHelpDesk HdEscalamiento?
}

model TicketTecnico {
  ticketId   String
  tecnicoId  String
  asignadoEn DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tecnico    Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)

  @@id([ticketId, tecnicoId])
}

model OrdenServicio {
  id              String              @id @default(cuid())
  ticketId        String              @unique
  iniciadoEn      DateTime?
  finalizadoEn    DateTime?
  latInicio       Float?
  lngInicio       Float?
  latFin          Float?
  lngFin          Float?
  servicioOk      Boolean             @default(false)
  potenciaOk      Boolean             @default(false)
  fotosOk         Boolean             @default(false)
  clienteConforme Boolean             @default(false)
  firmaOk         Boolean             @default(false)
  whatsappEnviado Boolean             @default(false)
  reportadoPorTecnicoId String?
  reportadoEn         DateTime?
  tipoConexionInstalacion TipoConexionInstalacion?
  direccionIp         String?
  pppoeUsuario        String?
  pppoeClave          String?
  nombreRedWifi       String?
  claveRedWifi        String?
  ticket          Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reportadoPor    Tecnico?            @relation("OrdenReportadaPor", fields: [reportadoPorTecnicoId], references: [id])
  cronometro      Cronometro?
  medicion        Medicion?
  fotografias     Fotografia[]
  firma           Firma?
  materiales      MaterialUtilizado[]
}

model Cronometro {
  id              String        @id @default(cuid())
  ordenId         String        @unique
  inicio          DateTime?
  fin             DateTime?
  pausasJson      String        @default("[]")
  duracionSegundos Int          @default(0)
  activo          Boolean       @default(false)
  pausado         Boolean       @default(false)
  orden           OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model UbicacionGps {
  id        String   @id @default(cuid())
  tecnicoId String
  lat       Float
  lng       Float
  precision Float?
  timestamp DateTime @default(now())
  tecnico   Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
}

model Medicion {
  id           String        @id @default(cuid())
  ordenId      String        @unique
  rxDbm        Float
  txDbm        Float
  pingMs       Float?
  downloadMbps Float
  uploadMbps   Float
  registradoEn DateTime      @default(now())
  orden        OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Fotografia {
  id         String        @id @default(cuid())
  ordenId    String
  tipo       TipoFoto
  url        String
  imagenData String?       @db.Text
  lat        Float?
  lng        Float?
  tomadaEn   DateTime      @default(now())
  orden      OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Firma {
  id            String        @id @default(cuid())
  ordenId       String        @unique
  nombreCliente String
  cedula        String
  imagenUrl     String
  imagenData    String?       @db.Text
  lat           Float?
  lng           Float?
  firmadoEn     DateTime      @default(now())
  orden         OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Inventario {
  id         String          @id @default(cuid())
  nombre     String          @unique
  unidad     String          @default("unidad")
  tipo       TipoInventario  @default(CONSUMIBLE)
  stock      Float           @default(0)
  stockMin   Float           @default(5)
  createdAt  DateTime        @default(now())
  materiales MaterialUtilizado[]
}

model MaterialUtilizado {
  id            String         @id @default(cuid())
  ordenId       String
  inventarioId  String
  cantidad      Float
  serie         String?
  modelo        String?
  marca         String?
  tipoPatchCord TipoPatchCord?
  excedenteMetros Float?
  orden         OrdenServicio  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  inventario    Inventario     @relation(fields: [inventarioId], references: [id])
}

model EvaluacionCliente {
  id          String   @id @default(cuid())
  ticketCodigo String
  calificacion Int
  comentario  String?
  createdAt   DateTime @default(now())
}

model EventoTicket {
  id        String   @id @default(cuid())
  ticketId  String
  usuarioId String?
  accion    String
  metadata  String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

// ─── Infinity Remote Help Desk (solo web) ───────────────────────────────────

enum HdCanal {
  WHATSAPP
  CHAT
  LLAMADA
  VIDEO
}

enum HdEstadoConversacion {
  EN_COLA
  EN_ATENCION
  EN_ESPERA_CLIENTE
  RESUELTO
  ESCALADO
  CERRADO
}

enum HdTipoCliente {
  EXISTENTE
  NUEVO
  PROSPECTO
}

enum HdMotivoEscalamiento {
  FIBRA_ROTA
  NAP_DANADA
  ONU_DANADA
  ROUTER_DANADO
  SIN_POTENCIA
  CAMBIO_ACOMETIDA
  INSTALACION
  MUDANZA
  REUBICACION
  OTRO
}

enum HdTipoAccionRemota {
  WIFI_SSID
  WIFI_PASSWORD
  WIFI_CANAL
  WIFI_OCULTAR
  ROUTER_REINICIO
  ROUTER_FIRMWARE
  ROUTER_BACKUP
  ROUTER_RESTORE
  SPEED_TEST
  PING
  TRACEROUTE
  DNS_TEST
  DIAG_POTENCIA
  DIAG_ONU
  DIAG_DISPOSITIVOS
  OTRO
}

enum HdAutorMensaje {
  CLIENTE
  AGENTE
  IA
  SISTEMA
}

model HdConversacion {
  id                String               @id @default(cuid())
  codigo            String               @unique
  clienteId         String?
  prospectoNombre   String?
  prospectoTelefono String?
  prospectoEmail    String?
  canal             HdCanal              @default(WHATSAPP)
  estado            HdEstadoConversacion @default(EN_COLA)
  tipoCliente       HdTipoCliente        @default(EXISTENTE)
  asignadoAId       String?
  ticketId          String?              @unique
  motivo            String?
  resumenIa         String?              @db.Text
  diagnosticoIa     String?              @db.Text
  prioridad         Prioridad            @default(MEDIA)
  slaVenceEn        DateTime?
  satisfaccion      Int?
  metadataJson      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cerradoEn         DateTime?
  cliente           Cliente?             @relation(fields: [clienteId], references: [id])
  asignadoA         Usuario?             @relation("HdAgenteUsuario", fields: [asignadoAId], references: [id])
  ticket            Ticket?              @relation(fields: [ticketId], references: [id])
  mensajes          HdMensaje[]
  acciones          HdAccionRemota[]
  escalamiento      HdEscalamiento?
  sugerencias       HdSugerenciaIa[]

  @@index([estado])
  @@index([asignadoAId])
  @@index([createdAt])
}

model HdMensaje {
  id             String         @id @default(cuid())
  conversacionId String
  autor          HdAutorMensaje
  usuarioId      String?
  contenido      String         @db.Text
  metadataJson   String?
  createdAt      DateTime       @default(now())
  conversacion   HdConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
}

model HdAccionRemota {
  id              String           @id @default(cuid())
  conversacionId  String
  usuarioId       String
  tipo            HdTipoAccionRemota
  configAnterior  String?          @db.Text
  configNueva     String?          @db.Text
  motivo          String?
  observaciones   String?
  ipAgente        String?
  exito           Boolean          @default(true)
  resultadoJson   String?          @db.Text
  createdAt       DateTime         @default(now())
  conversacion    HdConversacion   @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([conversacionId])
  @@index([createdAt])
}

model HdEscalamiento {
  id               String              @id @default(cuid())
  conversacionId   String              @unique
  motivo           HdMotivoEscalamiento
  ticketEscaladoId String?             @unique
  resumenIa        String              @db.Text
  diagnostico      String?             @db.Text
  accionesJson     String?             @db.Text
  materialSugerido String?
  tiempoEstimadoMin Int?
  prioridad        Prioridad           @default(MEDIA)
  createdAt        DateTime            @default(now())
  conversacion     HdConversacion      @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  ticketEscalado   Ticket?             @relation(fields: [ticketEscaladoId], references: [id])
}

model HdSugerenciaIa {
  id             String         @id @default(cuid())
  conversacionId String
  tipo           String
  contenido      String         @db.Text
  metadataJson   String?
  createdAt      DateTime       @default(now())
  conversacion   HdConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
}

model HdArticuloConocimiento {
  id        String   @id @default(cuid())
  titulo    String
  categoria String
  marca     String?
  contenido String   @db.Text
  tags      String   @default("")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoria])
  @@index([marca])
}

model HdSesionAgente {
  id         String   @id @default(cuid())
  usuarioId  String   @unique
  conectado  Boolean  @default(false)
  ultimoPing DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
