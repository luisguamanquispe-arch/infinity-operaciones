generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  TECNICO
  SUPERVISOR
  ADMIN
  HELP_DESK
  CLIENTE
}

enum EstadoTecnico {
  DISPONIBLE
  TRABAJANDO
  DESCANSO
  OFFLINE
}

enum TipoTrabajo {
  INSTALACION
  SOPORTE
  INFRAESTRUCTURA
  MIGRACION
  RECONEXION
  RETIRO
  CORTE
}

enum MotivoInfraestructura {
  CORTE_ELECTRICO
  CORTE_FIBRA
  CONFIG_NODO
  ACTUALIZACION
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoTicket {
  PENDIENTE
  LEIDO
  EN_PROCESO
  FINALIZADO
  CERRADO
  CANCELADO
}

enum TipoConexionInstalacion {
  IP
  PPPOE
}

enum TipoFoto {
  FACHADA
  POSTE
  NAP
  TRABAJO
  EMPALME
  CAJA_TERMINAL
  ONU
  SPEEDTEST
  CLIENTE_CONFORME
}

enum TipoInventario {
  CONSUMIBLE
  PATCHCORD
  EQUIPO
}

enum TipoPatchCord {
  APC_APC
  APC_UPC
  UPC_UPC
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  tecnico      Tecnico?
  cuentaCliente AppClienteCuenta?
  eventos      EventoTicket[]
  conversacionesHelpDesk HdConversacion[] @relation("HdAgenteUsuario")
  accionesHelpDesk       HdAccionRemota[]
  sesionHelpDesk         HdSesionAgente?
  historialesCliente     HistorialCliente[]
  novedadesResueltas     NovedadTicket[]    @relation("NovedadResueltaPor")
  refreshTokensCliente   AppClienteRefreshToken[]
  deviceTokensCliente    AppClienteDeviceToken[]
  irReportesSupervisados IrReporte[] @relation("IrSupervisor")
  irReportesCreados      IrReporte[] @relation("IrCreadoPor")
  srTicketsOperados      SrTicket[]  @relation("SrOperador")
  srHistoriales          SrHistorial[]
}

model Tecnico {
  id           String        @id @default(cuid())
  usuarioId    String        @unique
  telefono     String?
  vehiculo     String?
  estadoActual EstadoTecnico @default(DISPONIBLE)
  lat          Float?
  lng          Float?
  updatedAt    DateTime      @updatedAt
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  asignaciones TicketTecnico[]
  ubicaciones  UbicacionGps[]
  ordenesReportadas OrdenServicio[] @relation("OrdenReportadaPor")
  novedadesReportadas NovedadTicket[]
  irReportes   IrReporte[]
}

model Cliente {
  id        String   @id @default(cuid())
  cedula    String   @unique
  nombre    String
  telefono  String
  plan      String
  direccion String
  sector    String
  referencia String?
  lat       Float?
  lng       Float?
  nodo      String?
  cajaNap   String?
  puerto    String?
  onuSerial String?
  potencia  Float?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
  conversacionesHelpDesk HdConversacion[]
  historial HistorialCliente[]
  cuentaApp AppClienteCuenta?
  speedTests AppClienteSpeedTest[]
  srTickets SrTicket[]
}

/// Cuenta de la app INFINITY Connect vinculada a un Cliente CRM.
model AppClienteCuenta {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  clienteId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

/// Refresh tokens rotativos para la app móvil (hash SHA-256, nunca en claro).
model AppClienteRefreshToken {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
}

/// Resultados de speed test desde INFINITY Connect (medición vía API Soporte).
model AppClienteSpeedTest {
  id           String   @id @default(cuid())
  clienteId    String
  pingMs       Float?
  downloadMbps Float
  uploadMbps   Float
  planMbps     Int?
  calidad      String
  servidor     String   @default("infinity-soporte")
  plataforma   String?
  createdAt    DateTime @default(now())
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, createdAt])
}

/// Tokens FCM / push de INFINITY Connect (por usuario CLIENTE).
model AppClienteDeviceToken {
  id         String   @id @default(cuid())
  usuarioId  String
  token      String   @unique
  plataforma String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model HistorialCliente {
  id          String   @id @default(cuid())
  clienteId   String
  usuarioId   String?
  accion      String
  cambiosJson String   @db.Text
  createdAt   DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([clienteId, createdAt])
}

model Ticket {
  id                   String                 @id @default(cuid())
  codigo               String                 @unique
  clienteId            String
  tecnicoId            String?
  tipo                 TipoTrabajo
  prioridad            Prioridad              @default(MEDIA)
  estado               EstadoTicket           @default(PENDIENTE)
  motivo               String?
  descripcion          String?
  motivoInfraestructura MotivoInfraestructura?
  nodoAfectado         String?
  zonaInfra            String?
  slaHoras             Int                    @default(8)
  slaVenceEn           DateTime?
  programadoEn         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  cliente              Cliente                @relation(fields: [clienteId], references: [id])
  tecnico              Tecnico?               @relation(fields: [tecnicoId], references: [id])
  tecnicos             TicketTecnico[]
  orden                OrdenServicio?
  eventos              EventoTicket[]
  conversacionHelpDesk HdConversacion?
  escalamientoHelpDesk HdEscalamiento?
  novedades            NovedadTicket[]
}

model TicketTecnico {
  ticketId   String
  tecnicoId  String
  asignadoEn DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tecnico    Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)

  @@id([ticketId, tecnicoId])
}

model OrdenServicio {
  id              String              @id @default(cuid())
  ticketId        String              @unique
  iniciadoEn      DateTime?
  finalizadoEn    DateTime?
  latInicio       Float?
  lngInicio       Float?
  latFin          Float?
  lngFin          Float?
  servicioOk      Boolean             @default(false)
  potenciaOk      Boolean             @default(false)
  fotosOk         Boolean             @default(false)
  clienteConforme Boolean             @default(false)
  firmaOk         Boolean             @default(false)
  whatsappEnviado Boolean             @default(false)
  reportadoPorTecnicoId String?
  reportadoEn         DateTime?
  tipoConexionInstalacion TipoConexionInstalacion?
  direccionIp         String?
  pppoeUsuario        String?
  pppoeClave          String?
  nombreRedWifi       String?
  claveRedWifi        String?
  /// Resumen del soporte / trabajo efectuado (ingresa el técnico)
  resumenTrabajo      String?             @db.Text
  reportePdfUrl       String?
  reporteEnviadoWhatsapp Boolean          @default(false)
  reporteEnviadoEmail Boolean             @default(false)
  correoReporte       String?
  ticket          Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reportadoPor    Tecnico?            @relation("OrdenReportadaPor", fields: [reportadoPorTecnicoId], references: [id])
  cronometro      Cronometro?
  medicion        Medicion?
  fotografias     Fotografia[]
  firma           Firma?
  materiales      MaterialUtilizado[]
}

model Cronometro {
  id              String        @id @default(cuid())
  ordenId         String        @unique
  inicio          DateTime?
  fin             DateTime?
  pausasJson      String        @default("[]")
  duracionSegundos Int          @default(0)
  activo          Boolean       @default(false)
  pausado         Boolean       @default(false)
  orden           OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model UbicacionGps {
  id        String   @id @default(cuid())
  tecnicoId String
  lat       Float
  lng       Float
  precision Float?
  timestamp DateTime @default(now())
  tecnico   Tecnico  @relation(fields: [tecnicoId], references: [id], onDelete: Cascade)
}

model Medicion {
  id           String        @id @default(cuid())
  ordenId      String        @unique
  rxDbm        Float
  txDbm        Float
  pingMs       Float?
  downloadMbps Float
  uploadMbps   Float
  registradoEn DateTime      @default(now())
  orden        OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Fotografia {
  id         String        @id @default(cuid())
  ordenId    String
  tipo       TipoFoto
  url        String
  imagenData String?       @db.Text
  lat        Float?
  lng        Float?
  tomadaEn   DateTime      @default(now())
  orden      OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Firma {
  id                      String        @id @default(cuid())
  ordenId                 String        @unique
  nombreCliente           String
  cedula                  String
  imagenUrl               String
  imagenData              String?       @db.Text
  lat                     Float?
  lng                     Float?
  /// Cliente marcó la casilla de aceptación de condiciones al firmar
  aceptacionCondiciones   Boolean       @default(false)
  /// Texto legal aceptado (snapshot al momento de firmar)
  textoAceptacion         String?       @db.Text
  aceptadoEn              DateTime?
  firmadoEn               DateTime      @default(now())
  orden                   OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
}

model Inventario {
  id         String          @id @default(cuid())
  nombre     String          @unique
  unidad     String          @default("unidad")
  tipo       TipoInventario  @default(CONSUMIBLE)
  stock      Float           @default(0)
  stockMin   Float           @default(5)
  createdAt  DateTime        @default(now())
  materiales MaterialUtilizado[]
}

model MaterialUtilizado {
  id            String         @id @default(cuid())
  ordenId       String
  inventarioId  String
  cantidad      Float
  serie         String?
  modelo        String?
  marca         String?
  tipoPatchCord TipoPatchCord?
  excedenteMetros Float?
  orden         OrdenServicio  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  inventario    Inventario     @relation(fields: [inventarioId], references: [id])
}

model EvaluacionCliente {
  id          String   @id @default(cuid())
  ticketCodigo String
  calificacion Int
  comentario  String?
  createdAt   DateTime @default(now())
}

model EventoTicket {
  id        String   @id @default(cuid())
  ticketId  String
  usuarioId String?
  accion    String
  metadata  String?
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
}

enum TipoNovedadTicket {
  CLIENTE_AUSENTE
  SOLICITA_REPROGRAMACION
  OTRO
}

enum EstadoNovedadTicket {
  PENDIENTE
  REPROGRAMADA
  DESCARTADA
}

model NovedadTicket {
  id                   String              @id @default(cuid())
  ticketId             String
  tecnicoId            String
  tipo                 TipoNovedadTicket
  comentario           String?             @db.Text
  fechaSolicitada      DateTime?
  estado               EstadoNovedadTicket @default(PENDIENTE)
  programadoEnAnterior DateTime?
  programadoEnNuevo    DateTime?
  resueltaPorId        String?
  resueltaEn           DateTime?
  createdAt            DateTime            @default(now())
  ticket               Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tecnico              Tecnico             @relation(fields: [tecnicoId], references: [id])
  resueltaPor          Usuario?            @relation("NovedadResueltaPor", fields: [resueltaPorId], references: [id])

  @@index([estado])
  @@index([ticketId])
  @@index([createdAt])
}

// ─── Infinity Remote Help Desk (solo web) ───────────────────────────────────

enum HdCanal {
  WHATSAPP
  CHAT
  LLAMADA
  VIDEO
}

enum HdEstadoConversacion {
  EN_COLA
  EN_ATENCION
  EN_ESPERA_CLIENTE
  RESUELTO
  ESCALADO
  CERRADO
}

enum HdTipoCliente {
  EXISTENTE
  NUEVO
  PROSPECTO
}

enum HdMotivoEscalamiento {
  FIBRA_ROTA
  NAP_DANADA
  ONU_DANADA
  ROUTER_DANADO
  SIN_POTENCIA
  CAMBIO_ACOMETIDA
  INSTALACION
  MUDANZA
  REUBICACION
  OTRO
}

enum HdTipoAccionRemota {
  WIFI_SSID
  WIFI_PASSWORD
  WIFI_CANAL
  WIFI_OCULTAR
  ROUTER_REINICIO
  ROUTER_FIRMWARE
  ROUTER_BACKUP
  ROUTER_RESTORE
  SPEED_TEST
  PING
  TRACEROUTE
  DNS_TEST
  DIAG_POTENCIA
  DIAG_ONU
  DIAG_DISPOSITIVOS
  OTRO
}

enum HdAutorMensaje {
  CLIENTE
  AGENTE
  IA
  SISTEMA
}

model HdConversacion {
  id                String               @id @default(cuid())
  codigo            String               @unique
  clienteId         String?
  prospectoNombre   String?
  prospectoTelefono String?
  prospectoEmail    String?
  canal             HdCanal              @default(WHATSAPP)
  estado            HdEstadoConversacion @default(EN_COLA)
  tipoCliente       HdTipoCliente        @default(EXISTENTE)
  asignadoAId       String?
  ticketId          String?              @unique
  motivo            String?
  resumenIa         String?              @db.Text
  diagnosticoIa     String?              @db.Text
  prioridad         Prioridad            @default(MEDIA)
  slaVenceEn        DateTime?
  satisfaccion      Int?
  metadataJson      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cerradoEn         DateTime?
  cliente           Cliente?             @relation(fields: [clienteId], references: [id])
  asignadoA         Usuario?             @relation("HdAgenteUsuario", fields: [asignadoAId], references: [id])
  ticket            Ticket?              @relation(fields: [ticketId], references: [id])
  mensajes          HdMensaje[]
  acciones          HdAccionRemota[]
  escalamiento      HdEscalamiento?
  sugerencias       HdSugerenciaIa[]

  @@index([estado])
  @@index([asignadoAId])
  @@index([createdAt])
}

model HdMensaje {
  id             String         @id @default(cuid())
  conversacionId String
  autor          HdAutorMensaje
  usuarioId      String?
  contenido      String         @db.Text
  metadataJson   String?
  createdAt      DateTime       @default(now())
  conversacion   HdConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
}

model HdAccionRemota {
  id              String           @id @default(cuid())
  conversacionId  String
  usuarioId       String
  tipo            HdTipoAccionRemota
  configAnterior  String?          @db.Text
  configNueva     String?          @db.Text
  motivo          String?
  observaciones   String?
  ipAgente        String?
  exito           Boolean          @default(true)
  resultadoJson   String?          @db.Text
  createdAt       DateTime         @default(now())
  conversacion    HdConversacion   @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([conversacionId])
  @@index([createdAt])
}

model HdEscalamiento {
  id               String              @id @default(cuid())
  conversacionId   String              @unique
  motivo           HdMotivoEscalamiento
  ticketEscaladoId String?             @unique
  resumenIa        String              @db.Text
  diagnostico      String?             @db.Text
  accionesJson     String?             @db.Text
  materialSugerido String?
  tiempoEstimadoMin Int?
  prioridad        Prioridad           @default(MEDIA)
  createdAt        DateTime            @default(now())
  conversacion     HdConversacion      @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  ticketEscalado   Ticket?             @relation(fields: [ticketEscaladoId], references: [id])
}

model HdSugerenciaIa {
  id             String         @id @default(cuid())
  conversacionId String
  tipo           String
  contenido      String         @db.Text
  metadataJson   String?
  createdAt      DateTime       @default(now())
  conversacion   HdConversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
}

model HdArticuloConocimiento {
  id        String   @id @default(cuid())
  titulo    String
  categoria String
  marca     String?
  contenido String   @db.Text
  tags      String   @default("")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoria])
  @@index([marca])
}

model HdSesionAgente {
  id         String   @id @default(cuid())
  usuarioId  String   @unique
  conectado  Boolean  @default(false)
  ultimoPing DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// ─── Infraestructura de Red (módulo independiente; no altera tickets INFRA) ───

enum IrEstadoReporte {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
}

enum IrTipoTrabajo {
  CORTE_FIBRA
  EMPALME
  CAMBIO_NAP
  CAMBIO_CTO
  CAMBIO_SPLITTER
  CAMBIO_POSTE
  CAMBIO_CABLE
  MANTENIMIENTO_PREVENTIVO
  MANTENIMIENTO_CORRECTIVO
  AMPLIACION_RED
  OTRO
}

enum IrTipoFoto {
  ANTES
  DURANTE
  DESPUES
}

enum IrTipoFirma {
  TECNICO
  SUPERVISOR
}

model IrReporte {
  id                  String          @id @default(cuid())
  codigo              String          @unique
  fecha               DateTime        @default(now())
  horaInicio          DateTime?
  horaFin             DateTime?
  tecnicoId           String
  supervisorUsuarioId String?
  estado              IrEstadoReporte @default(PENDIENTE)
  prioridad           Prioridad       @default(MEDIA)
  tipoTrabajo         IrTipoTrabajo
  tipoTrabajoOtro     String?
  provincia           String
  canton              String
  parroquia           String
  sector              String
  direccion           String
  lat                 Float?
  lng                 Float?
  descripcion         String          @db.Text
  observaciones       String?         @db.Text
  creadoPorId         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tecnico             Tecnico         @relation(fields: [tecnicoId], references: [id])
  supervisor          Usuario?        @relation("IrSupervisor", fields: [supervisorUsuarioId], references: [id])
  creadoPor           Usuario         @relation("IrCreadoPor", fields: [creadoPorId], references: [id])
  materiales          IrMaterial[]
  fotografias         IrFoto[]
  firmas              IrFirma[]

  @@index([estado, fecha])
  @@index([tecnicoId])
  @@index([sector])
}

model IrMaterial {
  id        String    @id @default(cuid())
  reporteId String
  material  String
  cantidad  Float
  unidad    String    @default("unidad")
  reporte   IrReporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId])
}

model IrFoto {
  id         String    @id @default(cuid())
  reporteId  String
  tipo       IrTipoFoto
  url        String
  imagenData String?   @db.Text
  tomadaEn   DateTime  @default(now())
  reporte    IrReporte @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([reporteId, tipo])
}

model IrFirma {
  id          String      @id @default(cuid())
  reporteId   String
  tipo        IrTipoFirma
  nombre      String
  imagenUrl   String
  imagenData  String?     @db.Text
  firmadoEn   DateTime    @default(now())
  reporte     IrReporte   @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@unique([reporteId, tipo])
  @@index([reporteId])
}

// ─── Soporte Remoto (oficina; independiente del soporte presencial) ───

enum SrEstado {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
}

enum SrTipoSoporte {
  CAMBIO_PASSWORD_WIFI
  CAMBIO_SSID
  REINICIO_ROUTER
  REINICIO_ONU
  REINICIO_PUERTO_OLT
  ACTUALIZACION_DATOS_CLIENTE
  CAMBIO_PLAN
  ACTIVACION_SERVICIO
  REACTIVACION_PAGO
  SUSPENSION_SERVICIO
  VERIFICACION_SENAL
  VERIFICACION_POTENCIA
  CONFIGURACION_WIFI
  CONFIGURACION_ROUTER
  CONFIGURACION_ONU
  CAMBIO_CANAL_WIFI
  ASISTENCIA_SMART_TV
  CONFIGURACION_IPTV
  CONFIGURACION_STREAMING
  ASESORIA_TELEFONICA
  CONSULTA_FACTURACION
  CONSULTA_PAGOS
  OTRO
}

enum SrResultado {
  SOLUCIONADO
  SOLUCIONADO_PARCIAL
  ESCALADO_SOPORTE_TECNICO
  REQUIERE_VISITA
  PENDIENTE_SEGUIMIENTO
  SIN_SOLUCION
}

enum SrTipoAdjunto {
  CAPTURA
  FOTO_CLIENTE
  PDF
  OTRO
}

model SrTicket {
  id                  String         @id @default(cuid())
  codigo              String         @unique
  fecha               DateTime       @default(now())
  horaInicio          DateTime?
  horaFin             DateTime?
  tiempoMinutos       Int?
  operadorId          String
  clienteId           String?
  clienteNombre       String
  clienteCodigo       String
  telefono            String
  estado              SrEstado       @default(PENDIENTE)
  tipoSoporte         SrTipoSoporte
  tipoSoporteOtro     String?
  descripcionProblema String         @db.Text
  solucionAplicada    String?        @db.Text
  resultado           SrResultado?
  observaciones       String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  operador            Usuario        @relation("SrOperador", fields: [operadorId], references: [id])
  cliente             Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  adjuntos            SrAdjunto[]
  historial           SrHistorial[]

  @@index([estado, fecha])
  @@index([operadorId])
  @@index([clienteCodigo])
  @@index([tipoSoporte])
}

model SrAdjunto {
  id            String       @id @default(cuid())
  ticketId      String
  tipo          SrTipoAdjunto
  nombreArchivo String
  mimeType      String
  url           String
  dataBase64    String?      @db.Text
  createdAt     DateTime     @default(now())
  ticket        SrTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SrHistorial {
  id            String   @id @default(cuid())
  ticketId      String
  fecha         DateTime @default(now())
  usuarioId     String
  usuarioNombre String
  tiempoMinutos Int?
  estado        SrEstado
  nota          String?
  ticket        SrTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([ticketId, fecha])
}
